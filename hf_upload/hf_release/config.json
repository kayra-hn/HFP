{
  "ENABLE_COHERENCE": false,
  "architectures": [
    "HFPForCausalLM"
  ],
  "auto_map": {
    "AutoConfig": "configuration_hfp.HFPConfig",
    "AutoModelForCausalLM": "modeling_hfp.HFPForCausalLM"
  },
  "aux_gate_entropy_weight": 0.0,
  "aux_ortho_weight": 0.0,
