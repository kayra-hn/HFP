  "max_short_len": null,
  "model_type": "hfp",
  "num_attention_heads": 12,
  "num_hidden_layers": 12,
  "pe_scale": 0.3,
  "rec_block": 64,
  "short_len": 8,
  "tie_word_embeddings": true,
  "transformers_version": "5.13.0",
  "tunnel_decay": 0.8,
  "tunnel_depth": 3,
  "vocab_size": 50257,
  "write_rule": "additive"
