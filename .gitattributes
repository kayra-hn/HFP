# HFP Git Attributes Configuration (Line Endings & Binary Handling)
# Set default behavior to LF for text files to prevent EOL diff artifacts

*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.tex text eol=lf
*.sh text eol=lf

# Binary files - preserve exact byte values
*.pt binary
*.safetensors binary
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.pyc binary
